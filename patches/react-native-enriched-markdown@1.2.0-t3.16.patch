+  // No blocking gesture at all: with nothing to yield to, a registered
+  // handler would only shadow the usual touch dispatch.
+  if (tags.count == 0) {
+    [self drop];
+    return;
+  }
+  if (_registered && [_configuredTags isEqualToArray:tags]) {
+    return;
+  }
