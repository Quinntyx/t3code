+// One pass re-evaluates every input (overflow, tags, attach, relations) and
+// skips native and reflective work whenever nothing changed.
+- (void)sync
+{
+  if (!_overflowing) {
+    [self drop];
+    return;
+  }
+  if (_scrollView.window == nil) {
+    return;
+  }
